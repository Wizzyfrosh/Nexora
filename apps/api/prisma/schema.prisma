generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole       @default(BUSINESS_OWNER)
  emailVerified Boolean        @default(false)
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  auditLogs     AuditLog[]
  businesses    Business[]
  refreshTokens RefreshToken[]
  accountMails AccountMail[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  familyId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([familyId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  attempts  Int      @default(0)

  @@index([token])
  @@index([email])
  @@map("email_verification_tokens")
}

model AccountMail {
  id String @id @default(uuid())
  userId String
  purpose String
  tokenHash String
  encryptedToken String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@map("account_mails")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

model Business {
  id           String           @id @default(uuid())
  ownerId      String
  name         String
  slug         String           @unique
  description  String?
  logoUrl      String?
  bannerUrl    String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  workingHours Json             @default("[]")
  socialLinks  Json             @default("{}")
  isPublished  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  analytics    AnalyticsEvent[]
  observations AnalyticsObservation[]
  dailyCounts  AnalyticsDaily[]
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories   Category[]
  leads        Lead[]
  media        Media[]
  products     Product[]
  services     Service[]
  subscription Subscription?
  website      Website?

  @@index([slug])
  @@index([ownerId])
  @@map("businesses")
}

model Plan {
  id               String           @id @default(uuid())
  name             SubscriptionPlan @unique
  displayName      String
  priceNgn         Int
  billingCycle     String           @default("yearly")
  features         Json             @default("[]")
  isPremium        Boolean          @default(false)
  paystackPlanCode String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  businessId             String             @unique
  plan                   SubscriptionPlan   @default(TRIAL)
  status                 SubscriptionStatus @default(TRIAL)
  trialStartDate         DateTime           @default(now())
  trialEndDate           DateTime
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  paystackSubscriptionId String?            @unique
  paystackCustomerId     String?
  billingAnchorPaymentId String? @unique
  billingAnchorPayment Payment? @relation("BillingAnchor", fields: [billingAnchorPaymentId], references: [id], onDelete: SetNull)
  renewalStatus          String @default("UNLINKED")
  providerStatusUpdatedAt DateTime?
  nextProviderSyncAt     DateTime?
  cancelRequestedAt      DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  payments               Payment[]
  business               Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([paystackSubscriptionId])
  @@index([nextProviderSyncAt])
  @@map("subscriptions")
}

model Payment {
  id                String       @id @default(uuid())
  subscriptionId    String
  amountNgn         Int
  currency          String       @default("NGN")
  paystackReference String       @unique
  paystackStatus    String
  paidAt            DateTime?
  expectedAmountKobo Int?
  expectedEmail     String?
  purchasedPlan     SubscriptionPlan?
  billingCycle      String?
  providerPlanCode  String?
  providerTransactionId String? @unique
  fulfilledAt       DateTime?
  providerInvoiceCode String? @unique
  coverageStart DateTime?
  coverageEnd DateTime?
  metadata          Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingAnchorFor Subscription? @relation("BillingAnchor")

  @@index([subscriptionId])
  @@index([paystackReference])
  @@unique([subscriptionId, coverageStart])
  @@map("payments")
}

model PaymentEvent {
  id            String   @id // SHA-256 of signed raw delivery; no authorization/card data retained
  event         String
  reference     String?
  providerObjectId String?
  billingData Json @default("{}")
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@map("payment_events")
}

model Category {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  slug        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]
  services    Service[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@map("categories")
}

model Product {
  id             String              @id @default(uuid())
  businessId     String
  categoryId     String?
  name           String
  slug           String
  description    String?
  price          Decimal             @db.Decimal(12, 2)
  compareAtPrice Decimal?            @db.Decimal(12, 2)
  availability   ProductAvailability @default(IN_STOCK)
  isFeatured     Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  images         ProductImage[]
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category?           @relation(fields: [categoryId], references: [id])

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Service {
  id          String    @id @default(uuid())
  businessId  String
  categoryId  String?
  name        String
  slug        String
  description String?
  price       Decimal?  @db.Decimal(12, 2)
  priceLabel  String?
  images      Json      @default("[]")
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@unique([businessId, slug])
  @@index([businessId])
  @@map("services")
}

model Website {
  id           String           @id @default(uuid())
  businessId   String           @unique
  theme        String           @default("DEFAULT")
  colorPalette Json             @default("{}")
  typography   Json             @default("{}")
  customDomain String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  sections     WebsiteSection[]
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("websites")
}

model WebsiteSection {
  id        String    @id @default(uuid())
  websiteId String
  type      String
  order     Int
  content   Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  website   Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([order])
  @@map("website_sections")
}

model Theme {
  id              String    @id @default(uuid())
  themeId         ThemeId   @unique
  name            String
  isPremium       Boolean   @default(false)
  colors          Json
  darkColors      Json
  typography      Json
  spacing         Json
  previewImageUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("themes")
}

model Lead {
  id         String    @id @default(uuid())
  businessId String
  name       String
  email      String?
  phone      String?
  message    String
  source     String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isRead])
  @@index([businessId, createdAt])
  @@map("leads")
}

model Media {
  id         String    @id @default(uuid())
  businessId String
  type       MediaType
  url        String
  publicId   String
  altText    String?
  sizeBytes  Int
  width      Int?
  height     Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  status     String    @default("LEGACY")
  assetId    String?   @unique
  cleanupAt  DateTime?
  attempts   Int       @default(0)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
  @@index([businessId, status])
  @@index([status, cleanupAt])
  @@map("media")
}

model AnalyticsEvent {
  id         String             @id @default(uuid())
  businessId String
  eventType  AnalyticsEventType
  resourceId String?
  metadata   Json               @default("{}")
  sessionId  String
  timestamp  DateTime           @default(now())
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([eventType])
  @@index([timestamp])
  @@index([businessId, eventType, timestamp])
  @@map("analytics_events")
}

// New first-party counters never use legacy sessionId/metadata/IP-bearing rows.
model AnalyticsObservation {
  id          String             @id @default(uuid())
  businessId  String
  eventId     String
  eventType   AnalyticsEventType
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  status      String             @default("PENDING")
  attempts    Int                @default(0)
  availableAt DateTime           @default(now())
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, eventId])
  @@index([businessId, receivedAt])
  @@index([businessId, status])
  @@index([status, availableAt, receivedAt])
  @@index([receivedAt])
  @@map("analytics_observations")
}

model AnalyticsDaily {
  id         String             @id @default(uuid())
  businessId String
  day        DateTime           @db.Date
  eventType  AnalyticsEventType
  count      Int                @default(0)
  updatedAt  DateTime           @updatedAt
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day, eventType])
  @@index([day])
  @@map("analytics_daily")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  STAFF
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
}

enum SectionType {
  HERO
  ABOUT
  PRODUCTS
  SERVICES
  GALLERY
  TESTIMONIALS
  FAQ
  CONTACT
  SOCIAL_LINKS
  ANNOUNCEMENT_BAR
}

enum ThemeId {
  MODERN_WHITE
  BUSINESS_GREEN
  PORTFOLIO_LITE
  LUXURY_GOLD
  FASHION_BLACK
  RESTAURANT_RED
  TECH_STARTUP
  CREATIVE_STUDIO
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  SERVICE_VIEW
  WHATSAPP_CLICK
  LEAD_FORM_SUBMISSION
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  COMING_SOON
}

enum MediaType {
  LOGO
  BANNER
  PRODUCT_IMAGE
  GALLERY_IMAGE
  SERVICE_IMAGE
}
