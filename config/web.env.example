# Copy to apps/web/.env.local
# This value is public and must include /api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Hosted deployment: set NEXT_PUBLIC_API_URL=/api/v1 and this server-only upstream.
# API_UPSTREAM_URL=https://YOUR_API_HOST/api/v1
# FRONTEND_URL on the API must exactly match the deployed browser origin.
# Canonical web origin without a trailing slash. Unset means no indexing/sitemap entries.
SITE_URL=http://localhost:3000
# Never put DB/JWT/Cloudinary/Paystack secret keys in NEXT_PUBLIC_ variables.
