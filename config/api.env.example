# Copy to apps/api/.env. PLACEHOLDERS ONLY. Never commit real credentials.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
# New publish actions remain disabled until launch gates are approved.
# Does not unpublish existing rows; entitlement and verification still gate reads.
PUBLIC_PUBLISHING_ENABLED=false
# Optional first-party visit counting. Requires privacy review and a scheduled analytics worker.
ANALYTICS_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nexora_dev
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=REPLACE_WITH_PRIVATE_RANDOM_ACCESS_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_PRIVATE_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRATION=7d
# Provider test keys only until billing safety milestone is complete
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Existing config exposes this variable; Paystack webhook signatures use its secret key.
PAYSTACK_WEBHOOK_SECRET=
# Planned integrations; not operational solely from environment configuration
# Neon branch-specific storage credentials (server only).
NEON_STORAGE_BUCKET=nexora-public
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_HOST=
# Use brevo for HTTPS email on hosts that block SMTP. Keep smtp until configured.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Independent 32-byte key encoded as 64 hex characters. Protect and back up privately.
EMAIL_TOKEN_KEY=
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
